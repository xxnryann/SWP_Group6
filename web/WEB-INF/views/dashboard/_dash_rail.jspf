<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%-- Menu theo vai trò, nằm giữa thanh trên cùng (được include từ _header.jspf khi railModule = true). --%>
<c:set var="railRole" value="${sessionScope.authUser.role}"/>
<nav class="topbar-nav" id="topbarNav" aria-label="Menu chính">
  <c:choose>
    <c:when test="${railRole == 'ADMIN'}">
      <a href="${ctx}/dashboard/admin">Tổng quan</a>
      <a href="${ctx}/admin/users">Người dùng</a>
      <a href="${ctx}/admin/rooms">Phòng chiếu</a>
      <a href="${ctx}/admin/system">Quản lý hệ thống</a>
    </c:when>
    <c:when test="${railRole == 'MANAGER'}">
      <a href="${ctx}/dashboard/manager">Tổng quan</a>
      <a href="${ctx}/manage/movies">Quản lý phim</a>
      <a href="${ctx}/manage/showtimes">Lịch chiếu</a>
      <a href="${ctx}/manager/news">Quản lý tin tức</a>
      <a href="${ctx}/manager/vouchers">Voucher</a>
      <a href="${ctx}/manager/prices">Giá vé</a>
      <a href="${ctx}/manager/mypoint">MyPoint</a>
    </c:when>
    <c:when test="${railRole == 'STAFF'}">
      <a href="${ctx}/dashboard/staff">Tổng quan</a>
      <a href="${ctx}/staff/counter">Bán vé tại quầy</a>
      <a href="${ctx}/staff/combo">Quản lý combo</a>
      <a href="${ctx}/staff/checkin">Soát vé</a>
      <a href="${ctx}/staff/seat-change">Đổi ghế</a>
    </c:when>
    <c:otherwise>
      <a href="${ctx}/showtimes">Lịch chiếu</a>
      <a href="${ctx}/movies">Danh sách phim</a>
      <a href="${ctx}/pricing">Giá vé</a>
      <a href="${ctx}/account/tickets">Lịch sử vé</a>
      <a href="${ctx}/account/inbox">Hộp thư</a>
      <a href="${ctx}/account/profile">Thông tin cá nhân</a>
      <a href="${ctx}/news">Tin tức</a>
    </c:otherwise>
  </c:choose>
</nav>