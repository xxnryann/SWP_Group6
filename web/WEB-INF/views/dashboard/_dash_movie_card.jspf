<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%-- Thẻ phim ở trang chủ. Cần: item (DashboardShowtime), upcoming (true = phim sắp chiếu). --%>
<c:set var="movie" value="${item.movie}"/>
<c:url var="detailUrl" value="/movies/detail"><c:param name="id" value="${movie.movieId}"/></c:url>
<c:set var="escapedDetailUrl"><c:out value="${detailUrl}"/></c:set>
<article class="mv-card">
  <div class="mv-poster">
    <a href="${escapedDetailUrl}" class="mv-poster-link" aria-label="Xem chi tiết <c:out value='${movie.title}'/>">
      <c:choose>
        <c:when test="${not empty movie.posterDisplayUrl}">
          <img src="${movie.uploadedPoster ? ctx : ''}<c:out value='${movie.posterDisplayUrl}'/>" alt="Poster phim <c:out value='${movie.title}'/>" loading="lazy">
        </c:when>
        <c:otherwise><div class="poster-placeholder">Chưa có poster</div></c:otherwise>
      </c:choose>
    </a>
    <span class="mv-age"><c:out value="${movie.ageRating}"/></span>
    <c:choose>
      <c:when test="${upcoming}"><span class="mv-flag mv-flag-soon">Sắp chiếu</span></c:when>
      <c:otherwise><span class="mv-flag mv-flag-now">Đang chiếu</span></c:otherwise>
    </c:choose>
    <div class="mv-overlay"><a class="btn btn-outline btn-sm" href="${escapedDetailUrl}">Xem chi tiết</a></div>
  </div>
  <div class="mv-body">
    <h3><a href="${escapedDetailUrl}"><c:out value="${movie.title}"/></a></h3>
    <p class="mv-meta">
      <c:if test="${not empty movie.genres}"><span>Thể loại: <strong><c:out value="${movie.genres}"/></strong></span></c:if>
      <span>Thời lượng: <strong><c:out value="${movie.durationMinutes}"/> phút</strong></span>
      <c:choose>
        <c:when test="${upcoming}">
          <span>Khởi chiếu: <strong><c:out value="${movie.releaseDate.dayOfMonth}"/>/<c:out value="${movie.releaseDate.monthValue}"/>/<c:out value="${movie.releaseDate.year}"/></strong></span>
        </c:when>
        <c:when test="${not empty item.nextShowtimeLabel}">
          <span>Suất gần nhất: <strong><c:out value="${item.nextShowtimeLabel}"/></strong></span>
        </c:when>
      </c:choose>
    </p>
    <c:choose>
      <c:when test="${upcoming}"><a class="btn btn-outline btn-block" href="${escapedDetailUrl}">Xem chi tiết</a></c:when>
      <c:otherwise><a class="btn btn-primary btn-block" href="${ctx}/showtimes">Mua vé</a></c:otherwise>
    </c:choose>
  </div>
</article>
