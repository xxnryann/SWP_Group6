      </div>
      <div>
        <h4>Dịch vụ</h4>
        <ul><li><a href="#">Mua vé online</a></li><li><a href="#">Thẻ quà tặng</a></li><li><a href="#">Thuê rạp</a></li><li><a href="#">Bắp nước combo</a></li></ul>
      </div>
      <div>
        <h4>Hỗ trợ</h4>
        <ul><li>Hotline: <a href="tel:1900636807">1900 636807</a></li><li><a href="#">Câu hỏi thường gặp</a></li><li><a href="#">Liên hệ</a></li><li><a href="#">Tuyển dụng</a></li></ul>
      </div>
      <div>
        <h4>Chính sách</h4>
        <ul><li><a href="#">Điều khoản sử dụng</a></li><li><a href="#">Chính sách bảo mật</a></li><li><a href="#">Chính sách thanh toán</a></li><li><a href="#">Quy định hoàn vé</a></li></ul>
      </div>
