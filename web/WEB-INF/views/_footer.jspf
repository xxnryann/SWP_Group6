<div class="modal" id="modal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
  <div class="modal-dialog">
    <h3 id="modalTitle"></h3>
    <p id="modalBody"></p>
    <div class="modal-actions"><button class="btn btn-soft" type="button" data-modal-close>ÄÃ³ng</button></div>
  </div>
</div>

<script>
(function () {
  var $ = function (s, r) { return (r || document).querySelector(s); };
  var $$ = function (s, r) { return Array.prototype.slice.call((r || document).querySelectorAll(s)); };
  function store(fn) { try { return fn(); } catch (e) { return null; } }

  /* Toast: tá»± áº©n sau 3 giÃ¢y */
  window.showToast = function (msg, type) {
    var t = document.createElement('div');
    t.className = 'toast' + (type ? ' toast-' + type : '');
    t.textContent = msg;
    $('#toastStack').appendChild(t);
    setTimeout(function () { t.remove(); }, 3000);
  };
  var stack = $('#toastStack');
  if (stack.dataset.flash) {
    showToast(stack.dataset.flash, stack.dataset.flashType === 'error' ? 'error' : stack.dataset.flashType === 'success' ? 'success' : '');
  }
  $$('[data-toast]').forEach(function (a) {
    a.addEventListener('click', function (e) { e.preventDefault(); showToast(a.dataset.toast); });
  });

  /* Modal: Ä‘Ã³ng báº±ng nÃºt, click ná»n hoáº·c phÃ­m Esc */
  var modal = $('#modal');
  window.openModal = function (title, body) {
    $('#modalTitle').textContent = title; $('#modalBody').textContent = body; modal.classList.add('open');
  };
  window.closeModal = function () { modal.classList.remove('open'); };
  modal.addEventListener('click', function (e) { if (e.target === modal || e.target.hasAttribute('data-modal-close')) closeModal(); });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') { closeModal(); document.body.classList.remove('drawer-open'); $$('.dropdown.open').forEach(function (d) { d.classList.remove('open'); }); }
  });

  /* Dropdown "KhÃ¡c" má»Ÿ báº±ng click */
  $$('.dropdown > button').forEach(function (b) {
    b.addEventListener('click', function (e) {
      e.stopPropagation();
      var d = b.parentElement, open = !d.classList.contains('open');
      d.classList.toggle('open', open); b.setAttribute('aria-expanded', open);
    });
  });
  document.addEventListener('click', function () { $$('.dropdown.open').forEach(function (d) { d.classList.remove('open'); }); });

  /* Mobile drawer (chá»‰ cÃ³ trÃªn trang cÃ´ng khai; trang ná»™i bá»™ bá» thanh nav) */
  function drawer(open) { document.body.classList.toggle('drawer-open', open); }
  var menuBtn = $('#menuBtn');
  if (menuBtn) menuBtn.addEventListener('click', function () { drawer(true); });
  var drawerClose = $('#drawerClose');
  if (drawerClose) drawerClose.addEventListener('click', function () { drawer(false); });
  var drawerBackdrop = $('#drawerBackdrop');
  if (drawerBackdrop) drawerBackdrop.addEventListener('click', function () { drawer(false); });

  /* Rail dá»c (menu role): má»Ÿ/Ä‘Ã³ng trÃªn mÃ n hÃ¬nh háº¹p */
  var railToggle = $('#railToggle');
  function rail(open) { document.body.classList.toggle('rail-open', open); }
  if (railToggle) {
    railToggle.addEventListener('click', function () {
      var open = !document.body.classList.contains('rail-open');
      rail(open);
      railToggle.setAttribute('aria-expanded', open);
    });
  }
  document.addEventListener('click', function (e) {
    if (!document.body.classList.contains('rail-open')) return;
    if (e.target.closest && e.target.closest('.dash-rail')) return;
    if (e.target === railToggle || railToggle.contains(e.target)) return;
    rail(false);
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') rail(false);
  });

  /* TÃ i khoáº£n hiá»‡n táº¡i -> localStorage.currentUser (nguá»“n tháº­t váº«n lÃ  session phÃ­a server) */
  var user = document.body.dataset.user;
  store(function () { user ? localStorage.setItem('currentUser', JSON.stringify({ name: user })) : localStorage.removeItem('currentUser'); });

  /* NgÃ´n ngá»¯ VIE/ENG (lÆ°u lá»±a chá»n; ná»™i dung hiá»‡n chá»‰ cÃ³ tiáº¿ng Viá»‡t) */
  var lang = store(function () { return localStorage.getItem('lang'); }) || 'vi';
  $$('.lang-switch button').forEach(function (b) {
    b.classList.toggle('active', b.dataset.lang === lang);
    b.addEventListener('click', function () {
      store(function () { localStorage.setItem('lang', b.dataset.lang); });
      $$('.lang-switch button').forEach(function (x) { x.classList.toggle('active', x === b); });
      if (b.dataset.lang === 'en') showToast('English version is coming soon.');
    });
  });

  /* Hiá»‡n/áº©n máº­t kháº©u */
  $$('.pw-toggle').forEach(function (b) {
    b.addEventListener('click', function () {
      var i = b.parentElement.querySelector('input'), show = i.type === 'password';
      i.type = show ? 'text' : 'password'; b.textContent = show ? 'áº¨n' : 'Hiá»‡n';
    });
  });

  /* NÃºt submit hiá»‡n spinner, chá»‘ng báº¥m Ä‘Ãºp */
  $$('form[novalidate], form[action$="verify-otp"]').forEach(function (f) {
    f.addEventListener('submit', function () {
      var b = f.querySelector('button[type=submit].btn');
      if (b) setTimeout(function () { b.classList.add('loading'); b.disabled = true; }, 0);
    });
  });
})();
</script>
</body>
</html>

