<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<%-- Đường dẫn dashboard theo vai trò (dùng cho link "Bảng điều khiển" + logo). --%>
<c:choose>
  <c:when test="${sessionScope.authUser.role == 'ADMIN'}"><c:set var="roleDashboardPath" value="/dashboard/admin"/></c:when>
  <c:when test="${sessionScope.authUser.role == 'MANAGER'}"><c:set var="roleDashboardPath" value="/dashboard/manager"/></c:when>
  <c:when test="${sessionScope.authUser.role == 'STAFF'}"><c:set var="roleDashboardPath" value="/dashboard/staff"/></c:when>
  <c:when test="${sessionScope.authUser.role == 'CUSTOMER'}"><c:set var="roleDashboardPath" value="/dashboard/customer"/></c:when>
  <c:otherwise><c:set var="roleDashboardPath" value="/home"/></c:otherwise>
</c:choose>
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><c:out value="${pageTitle}"/> · CineStar Cinemas</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&subset=vietnamese&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="${ctx}/assets/css/cinema.css">
  <c:if test="${movieModule}">
    <link rel="stylesheet" href="${ctx}/assets/css/movie.css">
  </c:if>
  <c:if test="${dashboardModule or railModule}">
    <link rel="stylesheet" href="${ctx}/assets/css/dashboard.css">
  </c:if>
</head>
<%-- Trang nội bộ theo vai trò (admin/manager/staff/customer) dùng sidebar riêng nên
     không hiện thanh nav công khai. Trang chủ "/" và các trang công khai giữ nguyên. --%>
<body class="${roleModule ? 'role-page' : ''} ${railModule ? 'has-rail' : ''}" data-user="<c:out value='${sessionScope.authUser.fullName}'/>">

<div class="topbar">
  <div class="container">
    <div class="topbar-left">
      <c:if test="${roleModule and not railModule}">
        <a class="topbar-brand" href="${ctx}<c:out value='${roleDashboardPath}'/>" aria-label="CineStar Cinemas">
          <svg width="24" height="24" viewBox="0 0 34 34" aria-hidden="true">
            <rect width="34" height="34" rx="9" fill="#1d4ed8"/>
            <path d="M17 6l3.2 6.6 7.3 1-5.3 5.1 1.3 7.2L17 22.4l-6.5 3.5 1.3-7.2-5.3-5.1 7.3-1z" fill="#f59e0b"/>
          </svg>
          <span>Cine<b>Star</b> Cinemas</span>
        </a>
      </c:if>
    </div>
    <div class="topbar-right">
      <div class="lang-switch" role="group" aria-label="Ngôn ngữ">
        <button type="button" data-lang="vi" class="active">VIE</button>
        <button type="button" data-lang="en">ENG</button>
      </div>
      <c:choose>
        <c:when test="${not empty sessionScope.authUser}">
          <span>Xin chào, <a href="${ctx}/account/profile"><strong><c:out value="${sessionScope.authUser.fullName}"/></strong></a></span>
          <c:if test="${not railModule}">
            <span class="sep">|</span>
            <a href="${ctx}<c:out value='${roleDashboardPath}'/>">Bảng điều khiển</a>
          </c:if>
          <c:if test="${not railModule}"><span class="sep">|</span></c:if>
          <form method="post" action="${ctx}/logout" id="logoutForm">
            <input type="hidden" name="_csrf" value="${csrf}">
            <c:choose>
              <c:when test="${railModule}">
                <button class="logout-icon" type="submit" title="Đăng xuất" aria-label="Đăng xuất">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="M16 17l5-5-5-5"/><path d="M21 12H9"/></svg>
                </button>
              </c:when>
              <c:otherwise><button class="btn-link" type="submit">Đăng xuất</button></c:otherwise>
            </c:choose>
          </form>
        </c:when>
        <c:otherwise>
          <span><a href="${ctx}/login">Đăng nhập</a> <span class="sep">|</span> <a href="${ctx}/register">Đăng ký</a></span>
        </c:otherwise>
      </c:choose>
    </div>
  </div>
</div>


<%-- Thanh menu trắng (đã đăng nhập): logo · chọn rạp · menu theo vai trò, chữ in hoa như site Beta Cinemas. --%>
<c:if test="${railModule}">
<header class="site-header role-header">
  <div class="container">
    <a class="logo" href="${ctx}/home" aria-label="CineStar Cinemas">
      <svg width="40" height="40" viewBox="0 0 34 34" aria-hidden="true">
        <rect width="34" height="34" rx="9" fill="#1d4ed8"/>
        <path d="M17 6l3.2 6.6 7.3 1-5.3 5.1 1.3 7.2L17 22.4l-6.5 3.5 1.3-7.2-5.3-5.1 7.3-1z" fill="#f59e0b"/>
      </svg>
      <span>Cine<b>Star</b></span>
    </a>
    <%@ include file="dashboard/_dash_rail.jspf" %>
  </div>
</header>
</c:if><%-- Trang nội bộ: bỏ hẳn thanh nav công khai (logo + Lịch Chiếu · Phim ·
     Giá Vé · Khuyến Mãi · Tin Tức · Khác · MUA VÉ NHANH) vì sidebar đã điều hướng đầy đủ.
     Trang chủ "/" và các trang công khai (khi chưa đăng nhập) vẫn giữ nguyên. --%>
<c:if test="${not roleModule and not railModule}">
<header class="site-header">
  <div class="container">
    <a class="logo" href="${ctx}<c:out value='${roleDashboardPath}'/>" aria-label="CineStar Cinemas">
      <svg width="34" height="34" viewBox="0 0 34 34" aria-hidden="true">
        <rect width="34" height="34" rx="9" fill="#1d4ed8"/>
        <path d="M17 6l3.2 6.6 7.3 1-5.3 5.1 1.3 7.2L17 22.4l-6.5 3.5 1.3-7.2-5.3-5.1 7.3-1z" fill="#f59e0b"/>
      </svg>
      <span>Cine<b>Star</b> Cinemas</span>
    </a>
    <nav class="main-nav" aria-label="Điều hướng chính">
      <%-- Movie module navigation additions; keep the existing News link below intact. --%>
      <a href="${ctx}/showtimes">Lịch Chiếu</a>
      <a href="${ctx}/movies">Phim</a>
      <a href="${ctx}/pricing">Giá Vé</a>
      <a href="${ctx}/promotions">Khuyến Mãi</a>
      <a href="${ctx}/news">Tin Tức</a>

      <a class="btn btn-cta" href="${ctx}/showtimes">MUA VÉ NHANH</a>
    </nav>
    <button class="menu-btn" type="button" aria-label="Mở menu" id="menuBtn">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>
  </div>
</header>
</c:if>

<%-- Trang nội bộ: drawer cũng bỏ các mục nav công khai (sidebar đã lo). --%>
<c:if test="${not roleModule and not railModule}">
  <div class="drawer-backdrop" id="drawerBackdrop"></div>
  <aside class="drawer" id="drawer" aria-label="Menu di động">
    <div class="drawer-head">
      <strong>Menu</strong>
      <button class="drawer-close" type="button" id="drawerClose" aria-label="Đóng">&times;</button>
    </div>
    <%-- Movie module navigation additions; the existing News link remains unchanged. --%>
    <a href="${ctx}/showtimes">Lịch Chiếu</a><a href="${ctx}/movies">Phim</a>
    <a href="${ctx}/pricing">Giá Vé</a><a href="${ctx}/promotions">Khuyến Mãi</a><a href="${ctx}/news">Tin Tức</a>
    <c:choose>
      <c:when test="${not empty sessionScope.authUser}">
        <a href="${ctx}<c:out value='${roleDashboardPath}'/>">Bảng điều khiển</a>
        <a href="${ctx}/account/profile">Tài khoản</a>
      </c:when>
      <c:otherwise><a href="${ctx}/login">Đăng nhập</a><a href="${ctx}/register">Đăng ký</a></c:otherwise>
    </c:choose>
    <a class="btn btn-cta" href="${ctx}/showtimes">MUA VÉ NHANH</a>
  </aside>
</c:if>

<%-- Trang nội bộ: bỏ breadcrumb của site công khai (sidebar đã có điều hướng riêng). --%>
<c:if test="${not roleModule and not railModule}">
<nav class="breadcrumb" aria-label="Breadcrumb">
  <div class="container">
    <ol>
      <li><a href="${ctx}/home">Trang chủ</a></li>
      <c:if test="${not empty parentTitle}"><li><a href="${parentUrl}"><c:out value="${parentTitle}"/></a></li></c:if>
      <c:if test="${pageTitle != 'Trang chủ'}"><li aria-current="page"><c:out value="${pageTitle}"/></li></c:if>
    </ol>
  </div>
</nav>
</c:if>

<div class="toast-stack" id="toastStack" aria-live="polite"
     data-flash-type="<c:out value='${flashType}'/>" data-flash="<c:out value='${flashMsg}'/>"></div>

