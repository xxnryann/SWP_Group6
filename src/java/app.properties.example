# Sao chep file nay thanh app.properties (cung thu muc) roi dien gia tri that.
# app.properties bi .gitignore chan: KHONG commit mat khau / khoa that len Git.

# ---- Database (SQL Server) ----
# Ten database phai khop voi script database/schema.sql
db.url=jdbc:sqlserver://localhost:1433;databaseName=CinemaWebDB;encrypt=true;trustServerCertificate=true
db.user=
db.password=

# ---- Media upload (poster/trailer). Dung duong dan tuyet doi de khong mat file khi redeploy ----
media.upload.root=

# ---- Email (OTP, thong bao). Uu tien: mail.api.key (API Brevo) -> mail.host (SMTP) -> de trong ca hai: chi ghi log (che do dev) ----
mail.api.key=
mail.api.url=https://api.brevo.com/v3/smtp/email
mail.from.name=CineStar Cinemas
mail.host=
mail.port=587
mail.user=
mail.password=
mail.from=no-reply@cinema.local

# ---- OTP ----
otp.ttl.minutes=5
otp.max.attempts=5

# ---- Cong thanh toan (VNPAY 2.1.0) ----
# Khi chua co vnpay.secretKey (hoac vnpay.mockGateway=true) he thong dung cong gia lap /mock/payment.
vnpay.partnerCode=
vnpay.secretKey=
vnpay.mockGateway=true
vnpay.paymentUrl=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
vnpay.bankCode=
vnpay.mockPaymentUrl=/mock/payment
